[Unit]
Description=BEVO Telemetry System
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=__BEVO_REPO__/BEVO
ExecStart=__BEVO_REPO__/BEVO/nonhermetic/start_telemetry.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment variables if needed
Environment=PYTHONPATH=__BEVO_REPO__

[Install]
WantedBy=multi-user.target