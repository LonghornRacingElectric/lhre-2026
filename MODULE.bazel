# OCI Container Base Images for Telemetry Services
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Python 3.11 base image for telemetry containers
oci.pull(
    name = "python311",
    image = "docker.io/library/python",
    tag = "3.11.4-slim",
    platforms = ["linux/amd64", "linux/arm64"],
)

# PostgreSQL base image
oci.pull(
    name = "postgres17",
    image = "docker.io/library/postgres",
    tag = "17",
    platforms = ["linux/amd64", "linux/arm64"],
)

# Eclipse Mosquitto MQTT broker
oci.pull(
    name = "mosquitto",
    image = "docker.io/library/eclipse-mosquitto",
    tag = "latest",
    platforms = ["linux/amd64", "linux/arm64"],
)

# Apache Kafka
oci.pull(
    name = "kafka",
    image = "docker.io/apache/kafka",
    tag = "4.1.0",
    platforms = ["linux/amd64"],
)

# Grafana
oci.pull(
    name = "grafana",
    image = "docker.io/grafana/grafana-oss",
    tag = "latest",
    platforms = ["linux/amd64", "linux/arm64"],
)

use_repo(
    oci,
    "python311",
    "python311_linux_amd64",
    "python311_linux_arm64",
    "postgres17",
    "postgres17_linux_amd64",
    "postgres17_linux_arm64",
    "mosquitto",
    "mosquitto_linux_amd64",
    "mosquitto_linux_arm64",
    "kafka",
    "kafka_linux_amd64",
    "grafana",
    "grafana_linux_amd64",
    "grafana_linux_arm64",
)
