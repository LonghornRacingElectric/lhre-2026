# bazelrc, defines default values for builds and bazel commands

common --incompatible_enable_cc_toolchain_resolution
common --incompatible_enable_proto_toolchain_resolution
build:firmware --platforms=//:arm_none_eabi
# run --platforms=@platforms//host

build:debug --spawn_strategy=local --strip=never

test --test_output=all

build:ci --bes_results_url=https://longhorn-racing-electric.buildbuddy.io/invocation/
build:ci --bes_backend=grpcs://longhorn-racing-electric.buildbuddy.io
build:ci --remote_cache=grpcs://longhorn-racing-electric.buildbuddy.io
build:ci --noremote_upload_local_results
build:ci --remote_timeout=10m

# Zig Compiler configuration
common --enable_platform_specific_config
build:linux --sandbox_add_mount_pair=/tmp
build:macos --sandbox_add_mount_pair=/var/tmp
build:windows --sandbox_add_mount_pair=C:\Temp
build --action_env BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1