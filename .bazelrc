# bazelrc, defines default values for builds and bazel commands

common --incompatible_enable_cc_toolchain_resolution
common --incompatible_enable_proto_toolchain_resolution
build:firmware --platforms=//:arm_none_eabi
# run --platforms=@platforms//host

build:debug --spawn_strategy=local --strip=never

test --test_output=all

common:ci --bes_results_url=https://longhorn-racing-electric.buildbuddy.io/invocation/
common:ci --bes_backend=grpcs://longhorn-racing-electric.buildbuddy.io
common:ci --remote_cache=grpcs://longhorn-racing-electric.buildbuddy.io
common:ci --remote_timeout=10m
common:ci --remote_executor=grpcs://longhorn-racing-electric.buildbuddy.io
common:ci --jobs=50
common:ci --noslim_profile
common:ci --build_metadata=VISIBILITY=PUBLIC

# Zig Compiler configuration
common --enable_platform_specific_config
build:linux --sandbox_add_mount_pair=/tmp
build:macos --sandbox_add_mount_pair=/var/tmp
build:windows --sandbox_add_mount_pair=C:\Temp
build --action_env BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

build:rust --extra_toolchains=@llvm_toolchain//:all
build:rust --define=toolchain=llvm
