load("//tools:outputs/build_outputs.bzl", "firmware_project_g4")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# HAL-free observer, also compiled into firmware by the existing usm/* glob.
cc_library(
    name = "wheel_phase",
    srcs = ["usm/wheel_phase.c"],
    hdrs = ["usm/wheel_phase.h"],
    includes = ["usm"],
    linkopts = ["-lm"],
    visibility = ["//visibility:public"],
)

firmware_project_g4(
    name = "usm_firmware_2026",
    linker_script = "STM32G474XX_FLASH.ld",
    startup_script = "startup_stm32g474xx.s",
    defines = [
        "STM32G474xx",
    ],
    enable_freertos = True,
    enable_usb = True,
    usb_device_name = "Upright Sensor Module",
    extra_includes = ["usm/"],
    extra_srcs = glob([
        "usm/*.c",
        "usm/*.h",
    ]),
    locations = [
        "RR",
        "RL",
        "FR",
        "FL",
    ],
)

cc_library(
    name = "mlx90395_frame",
    srcs = ["usm/mlx90395_frame.c"],
    hdrs = ["usm/mlx90395_frame.h"],
    includes = ["usm"],
    visibility = ["//visibility:public"],
)
