load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//legacy/2025:__subpackages__"])

cc_library(
    name = "LonghornLib2025_headers",
    hdrs = glob(
        [
            "*.h",
            "*.hpp",
        ],
        allow_empty = True,
    ),
    include_prefix = "LonghornLib",
    includes = ["."],
)

filegroup(
    name = "LonghornLib2025_srcs",
    srcs = glob(
        [
            "*.cpp",
            "*.c",
        ],
        allow_empty = True,
    ),
)
