load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:outputs/build_outputs.bzl", "firmware_project_h7")

firmware_project_h7(
    name = "hvc-firmware-2025",
    defines = [
        # Temporary PCB bring-up override: keep the IMD relay-hold output low
        # continuously. Remove this define after the IMD interface is reworked.
        "HVC_IMD_RELAY_HOLD_OVERRIDE=1",
        "STM32H733xx",
    ],
    extra_deps = [
        "//drivers/longhorn-lib:longhorn_can_base_stm32h7",
        "//legacy/2025/LonghornLib:LonghornLib2025_headers",
    ],
    extra_srcs = [
        "//legacy/2025/LonghornLib:LonghornLib2025_hvc_srcs",
        "@stm32_mw_usb_device//:usb_device_srcs",
    ],
    linker_script = "STM32H733VGTX_FLASH.ld",
    startup_script = "Core/Startup/startup_stm32h733vgtx.s",
)

cc_library(
    name = "state_machine_logic",
    srcs = ["Core/Src/state_machine_logic.c"],
    hdrs = [
        "Core/Inc/state_machine.h",
        "Core/Inc/state_machine_logic.h",
    ],
    includes = ["Core/Inc"],
)

cc_test(
    name = "state_machine_logic_test",
    srcs = ["tests/state_machine_logic_test.c"],
    linkstatic = True,
    deps = [":state_machine_logic"],
)

cc_library(
    name = "cell_fault_policy",
    srcs = ["Core/Src/cell_fault_policy.c"],
    hdrs = ["Core/Inc/cell_fault_policy.h"],
    includes = ["Core/Inc"],
)

cc_test(
    name = "cell_fault_policy_test",
    srcs = ["tests/cell_fault_policy_test.c"],
    linkstatic = True,
    deps = [":cell_fault_policy"],
)

cc_library(
    name = "imd_mode_policy",
    srcs = ["Core/Src/imd_mode_policy.c"],
    hdrs = ["Core/Inc/imd_mode_policy.h"],
    includes = ["Core/Inc"],
)

cc_test(
    name = "imd_mode_policy_test",
    srcs = ["tests/imd_mode_policy_test.c"],
    linkstatic = True,
    deps = [":imd_mode_policy"],
)
