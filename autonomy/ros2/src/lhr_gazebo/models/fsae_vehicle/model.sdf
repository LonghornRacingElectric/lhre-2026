<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fsae_vehicle">
    <!--
      FSAE driverless vehicle — simplified box geometry.
      Wheelbase: 1.6 m   Track width: 1.2 m   Wheel radius: 0.2 m
      Total mass: ~230 kg (200 chassis + 4x8 wheels)
      Reference point: rear axle center at ground level.
      Chassis center is 0.8 m forward (half wheelbase), 0.35 m up.
    -->

    <!-- ===== CHASSIS ===== -->
    <link name="chassis">
      <pose>0.8 0 0.35 0 0 0</pose>
      <inertial>
        <mass>200.0</mass>
        <inertia>
          <ixx>20.0</ixx>
          <iyy>80.0</iyy>
          <izz>80.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <pose>-0.07 -0.02 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carBody.stl</uri>
            <scale>1.7 1.7 1.7</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.3 0.0 1</ambient>
          <diffuse>0.8 0.3 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>2.2 1.0 0.25</size></box>
        </geometry>
      </collision>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>/imu/data</topic>
      </sensor>

      <!-- LiDAR sensor (VLP-16 Puck, front-mounted)
           Matches real Velodyne VLP-16 datasheet specs:
           - 16 channels, +/-15 deg vertical FOV, 2.0 deg spacing
           - 1800 horizontal samples at 10 Hz = 0.2 deg resolution
           - 0.9 m min range, 100 m max range
           - ~300,000 pts/sec single return -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>1.0 0 0.2 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/lidar/points</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.9</min>
            <max>100.0</max>
            <resolution>0.003</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ===== FRONT LEFT STEERING KNUCKLE ===== -->
    <link name="front_left_steering">
      <pose>1.6 0.6 0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1e6</effort>
          <velocity>10.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- FRONT LEFT WHEEL -->
    <link name="front_left_wheel">
      <pose>1.6 0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.59 -0.20 -0.61 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.17 2.17 2.17</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== FRONT RIGHT STEERING KNUCKLE ===== -->
    <link name="front_right_steering">
      <pose>1.6 -0.6 0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1e6</effort>
          <velocity>10.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- FRONT RIGHT WHEEL -->
    <link name="front_right_wheel">
      <pose>1.6 -0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.59 -0.20 -0.61 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.17 2.17 2.17</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR LEFT WHEEL (no steering knuckle) ===== -->
    <link name="rear_left_wheel">
      <pose>0 0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.59 -0.20 -0.61 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.17 2.17 2.17</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR RIGHT WHEEL (no steering knuckle) ===== -->
    <link name="rear_right_wheel">
      <pose>0 -0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.59 -0.20 -0.61 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.17 2.17 2.17</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== STEERING: direct position control (bypasses physics solver) ===== -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_left_steering_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_right_steering_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <!-- ===== DRIVE: direct velocity control ===== -->
    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>front_left_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_left_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>front_right_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_right_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/rear_left_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/rear_right_wheel_joint/cmd_vel</topic>
    </plugin>

    <!-- ===== GROUND-TRUTH ODOMETRY (world-frame pose, not wheel encoders) ===== -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/fsae_vehicle/odometry</odom_topic>
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
