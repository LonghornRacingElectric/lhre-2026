<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fsae_vehicle">
    <!--
      FSAE driverless vehicle — simplified box geometry.
      Wheelbase: 1.6 m   Track width: 1.2 m   Wheel radius: 0.2 m
      Total mass: ~230 kg (200 chassis + 4x8 wheels)
      Reference point: rear axle center at ground level.
      Chassis center is 0.8 m forward (half wheelbase), 0.35 m up.
    -->

    <!-- ===== CHASSIS ===== -->
    <link name="chassis">
      <pose>0.8 0 0.35 0 0 0</pose>
      <inertial>
        <mass>200.0</mass>
        <inertia>
          <ixx>20.0</ixx>
          <iyy>80.0</iyy>
          <izz>80.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <box><size>2.2 1.0 0.25</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.3 0.0 1</ambient>
          <diffuse>0.8 0.3 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>2.2 1.0 0.25</size></box>
        </geometry>
      </collision>

      <!-- Logical camera: mounted at front of chassis, facing forward (+X) -->
      <sensor name="logical_camera" type="logical_camera">
        <pose>1.1 0 0 0 0 0</pose>
        <logical_camera>
          <near>0.5</near>
          <far>20.0</far>
          <horizontal_fov>3.4907</horizontal_fov>
          <aspect_ratio>1.0</aspect_ratio>
        </logical_camera>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/logical_camera</topic>
      </sensor>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>/imu/data</topic>
      </sensor>
    </link>

    <!-- ===== FRONT LEFT STEERING KNUCKLE ===== -->
    <link name="front_left_steering">
      <pose>1.6 0.6 0.2 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1e6</effort>
        </limit>
      </axis>
    </joint>

    <!-- FRONT LEFT WHEEL -->
    <link name="front_left_wheel">
      <pose>1.6 0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== FRONT RIGHT STEERING KNUCKLE ===== -->
    <link name="front_right_steering">
      <pose>1.6 -0.6 0.2 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1e6</effort>
        </limit>
      </axis>
    </joint>

    <!-- FRONT RIGHT WHEEL -->
    <link name="front_right_wheel">
      <pose>1.6 -0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR LEFT WHEEL (no steering knuckle) ===== -->
    <link name="rear_left_wheel">
      <pose>0 0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR RIGHT WHEEL (no steering knuckle) ===== -->
    <link name="rear_right_wheel">
      <pose>0 -0.6 0.2 -1.5708 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx><iyy>0.16</iyy><izz>0.08</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== ACKERMANN STEERING PLUGIN ===== -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>1.2</kingpin_width>
      <wheel_base>1.6</wheel_base>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.2</wheel_radius>
      <steering_limit>0.61</steering_limit>
      <min_velocity>-5.0</min_velocity>
      <max_velocity>15.0</max_velocity>
      <min_acceleration>-5.0</min_acceleration>
      <max_acceleration>5.0</max_acceleration>
      <topic>/model/fsae_vehicle/cmd_vel</topic>
      <odom_topic>/model/fsae_vehicle/odometry</odom_topic>
      <tf_topic>/model/fsae_vehicle/tf</tf_topic>
      <frame_id>map</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
