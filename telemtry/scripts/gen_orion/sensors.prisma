model packet {
  packet_id BigInt @id
  time      BigInt

  dynamics dynamics?
  controls controls?
  pack pack?
  diagnostics_high diagnostics_high?
  diagnostics_low diagnostics_low?
  thermal thermal?
  board_status board_status?
}

model dynamics {
  packet_id BigInt @id
  gps                  Float[]
  gps_imu              Float[]
  gps_speed            Float?
  accel_pedal_travel   Float?
  steer_col_angle      Float?
  bl_sprung_accel      Float[]
  bl_unsprung_accel    Float[]
  br_sprung_accel      Float[]
  br_unsprung_accel    Float[]
  fl_sprung_accel      Float[]
  fl_unsprung_accel    Float[]
  fr_sprung_accel      Float[]
  fr_unsprung_accel    Float[]
  bl_ride_height       Float?
  bl_strain_gauge_v    Float?
  bl_sus_pot_v         Float?
  blw_speed            Float?
  br_ride_height       Float?
  br_strain_gauge_v    Float?
  br_sus_pot_v         Float?
  brw_speed            Float?
  fl_ride_height       Float?
  fl_strain_gauge_v    Float?
  fl_sus_pot_v         Float?
  flw_speed            Float?
  fr_ride_height       Float?
  fr_strain_gauge_v    Float?
  fr_sus_pot_v         Float?
  frw_speed            Float?
  ride_height          Float?
  wheel_speed          Float?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model controls {
  packet_id BigInt @id
  motor_speed          Float?
  torque_feedback      Float?
  apps1_travel         Float?
  apps1_v              Float?
  apps2_travel         Float?
  apps2_v              Float?
  bpps1_travel         Float?
  bpps1_v              Float?
  bpps2_travel         Float?
  bpps2_v              Float?
  brake_bias           Float?
  brake_light_pct      Float?
  brake_pressure_f     Float?
  brake_pressure_rall  Float?
  brake_pressure_rbll  Float?
  bse1_v               Float?
  bse2_v               Float?
  bse3_v               Float?
  lights_current       Float?
  rpm_request          Float?
  torque_command       Float?
  torque_limit         Float?
  torque_request       Float?
  commanded_torque     Float?
  motor_angle          Float?
  direction            Boolean?
  enable               Boolean?
  torque_shudder       Float?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model pack {
  packet_id BigInt @id
  bus_voltage          Float?
  lv_boards_current    Float?
  cells_v              Float[]
  dc_bus_v             Float?
  delta_resolver_angle Float?
  inverter_freq        Float?
  neutral_output_v     Float?
  time_since_on        Float?
  vab_vq_v             Float?
  vbc_vd_v             Float?
  cells_temps          Float[]
  dc_bus_current       Float?
  hv_c                 Float?
  hv_pack_v            Float?
  hv_soc               Float?
  lv_batt_c            Float?
  lv_batt_t            Float?
  lv_batt_v            Float?
  phase_a_current      Float?
  phase_b_current      Float?
  phase_c_current      Float?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model diagnostics_high {
  packet_id BigInt @id
  prndl_state          Float?
  shutdown_current     Float?
  hvc_state_machine    Float?
  post_faults          Float?
  run_faults           Float?
  apps1_disconnect     Boolean?
  apps1_out_range      Boolean?
  apps2_disconnect     Boolean?
  apps2_out_range      Boolean?
  apps_implause        Boolean?
  apps_mismatch        Boolean?
  batt_fans_fuse       Boolean?
  batt_pump_fuse       Boolean?
  boards_fuse          Boolean?
  bpps1_disconnect     Boolean?
  bpps1_out_range      Boolean?
  bpps2_disconnect     Boolean?
  bpps2_out_range      Boolean?
  bpps_mismatch        Boolean?
  brake_light_fuse     Boolean?
  bse1_disconnect      Boolean?
  bse1_out_range       Boolean?
  bse2_disconnect      Boolean?
  bse2_out_range       Boolean?
  ll_fuse              Boolean?
  motor_pump_fuse      Boolean?
  r2d_buzzer           Boolean?
  rtd_fuse             Boolean?
  shtdn_fuse           Boolean?
  shutdown_bspd_status Boolean?
  shutdown_emeter_status Boolean?
  spare_fuse           Boolean?
  stomp_fault          Boolean?
  tssi_green_fuse      Boolean?
  tssi_red_fuse        Boolean?
  neg_hv_contactor     Boolean?
  pos_hv_contactor     Boolean?
  precharge_contactor  Boolean?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model diagnostics_low {
  packet_id BigInt @id
  precharge_r_temp     Float?
  bmb_comm_error       Boolean?
  imd_gnd_isolation_error Boolean?
  r2d_authorized       Boolean?
  r2d_status           Boolean?
  shutdown_leg1        Boolean?
  shutdown_leg2        Boolean?
  shutdown_leg3        Boolean?
  shutdown_leg4        Boolean?
  temp_imd_1           Boolean?
  temp_imd_2           Boolean?
  temp_shutdown_1      Boolean?
  temp_shutdown_2      Boolean?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model thermal {
  packet_id BigInt @id
  batt_cooling_current Float?
  motor_cooling_current Float?
  ambient_temp         Float?
  motor_temp           Float?
  batt_loop_batt_temp  Float?
  batt_loop_rad_fan_speed Float?
  batt_loop_rad_temp   Float?
  battery_fan_rpm      Float?
  bus_bar_temp1        Float?
  bus_bar_temp2        Float?
  bus_bar_temp3        Float?
  cell_bottom_temp     Float?
  cell_top_temp        Float?
  coolant_flow_lpm     Float?
  coolant_temp         Float?
  discharge_r_temp     Float?
  fan_rpm              Float?
  gate_driver_temp     Float?
  inverter_hotspot_temp Float?
  inverter_temp        Float?
  module_a_temp        Float?
  module_b_temp        Float?
  module_c_temp        Float?
  motor_loop_inverter_temp Float?
  motor_loop_motor_temp Float?
  motor_loop_rad_temp  Float?
  temp_ams_1           Boolean?
  temp_ams_2           Boolean?
  temp_command_1       Boolean?
  temp_command_2       Boolean?
  temp_output_1        Boolean?
  temp_output_2        Boolean?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}

model board_status {
  packet_id BigInt @id
  csm_last_seen_s      Float?
  dui_last_seen_s      Float?
  hvc_last_seen_s      Float?
  inverter_last_seen_s Float?
  pdu_last_seen_s      Float?
  tsm_last_seen_s      Float?
  usm_last_seen_s      Float?
  vcu_last_seen_s      Float?

  packet packet @relation(fields: [packet_id], references: [packet_id])
}
