{
  "name": "viewer_tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "prisma-auth-generate": "npx prisma generate --schema=prisma/auth.prisma",
    "prisma-telemtry-generate": "npx prisma generate --schema=prisma/telemtry.prisma",
    "prisma-orion-generate": "npx prisma generate --schema=prisma/orion.prisma",
    "prisma-angelique-generate": "npx prisma generate --schema=prisma/angelique.prisma",
    "prisma-auth-seed": "npx ts-node --project tsconfig.ts-node.json prisma/auth_seed.ts",
    "prisma-telemtry-seed": "npx ts-node --project tsconfig.ts-node.json prisma/telemtry_seed.ts",
    "prisma-studio": "npx ts-node --project tsconfig.ts-node.json prisma/prisma-studio.ts",
    "protobuf-angelique": "mkdir -p protobuf && protoc -I ../../../stack/ingest/protobuf --ts_proto_out=protobuf --ts_proto_opt=esModuleInterop=true,env=node,outputServices=none ../../../stack/ingest/protobuf/angelique.proto",
    "protobuf-orion": "mkdir -p protobuf && cp ../../../../drivers/longhorn-lib/protobuf/can_packets.proto protobuf/orion.proto && protoc -I ../../../../drivers/longhorn-lib/protobuf --ts_proto_out=protobuf --ts_proto_opt=esModuleInterop=true,env=node,outputServices=none ../../../../drivers/longhorn-lib/protobuf/can_packets.proto"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/pg": "^8.10.9",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "i": "^0.3.7",
    "kafkajs": "^2.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.7",
    "next-auth": "^4.24.11",
    "pg": "^8.11.3",
    "protobufjs": "^7.5.4",
    "react": "^19.1.2",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.2",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.0.5",
    "screenfull": "^6.0.2",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "ts-proto": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
