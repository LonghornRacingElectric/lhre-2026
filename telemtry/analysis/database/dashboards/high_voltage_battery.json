      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aeup6culi7s3ke"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\r\n  SELECT \r\n    GREATEST(\r\n      (\r\n        LEAST(\r\n          p.end_time,\r\n          COALESCE((EXTRACT(EPOCH FROM $__timeTo()::timestamptz) * 1000)::bigint, p.end_time)\r\n        ) -\r\n        GREATEST(\r\n          p.start_time,\r\n          COALESCE((EXTRACT(EPOCH FROM $__timeFrom()::timestamptz) * 1000)::bigint, p.start_time)\r\n        )\r\n      ) / 5000.0,\r\n      1\r\n    ) AS bucket_len,\r\n    GREATEST(\r\n      p.start_time,\r\n      COALESCE((EXTRACT(EPOCH FROM $__timeFrom()::timestamptz) * 1000)::bigint, p.start_time)\r\n    ) AS effective_start,\r\n    LEAST(\r\n      p.end_time,\r\n      COALESCE((EXTRACT(EPOCH FROM $__timeTo()::timestamptz) * 1000)::bigint, p.end_time)\r\n    ) AS effective_end\r\n  FROM partitions p\r\n  WHERE p.partition_name = '$Zoom'\r\n),\r\nunnested AS (\r\n  SELECT\r\n    to_timestamp(\r\n      floor(packet.time / bounds.bucket_len) * bounds.bucket_len / 1000.0\r\n    ) AS time,\r\n    UNNEST(diagnostics.cells_v) AS cell_v\r\n  FROM diagnostics\r\n  JOIN packet ON packet.packet_id = diagnostics.packet_id\r\n  JOIN bounds ON true\r\n  JOIN partitions p ON p.partition_name = '$Zoom'\r\n  WHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\r\n)\r\nSELECT\r\n  time,\r\n  AVG(cell_v) AS avg_cells_v\r\nFROM unnested\r\nGROUP BY time\r\nORDER BY time;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [
                  {
                    "name": "cells_v",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "diagnostics"
        }
      ],
      "title": "Cell Voltages",
      "type": "barchart"
    },
