{
  "title": "Thermals - Angelique (Real-time)",
  "uid": "angelique_thermals_rt",
  "time": {
    "from": "now-1m",
    "to": "now"
  },
  "refresh": "1s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ambient Temperature",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        {
          "refId": "A",
          "topicName": "grafana_data",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "ambient_temp"] } } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Motor & Inverter Temperatures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        {
          "refId": "A",
          "topicName": "grafana_data",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "motor_temp", "inverter_temp"] } } }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cell Temperature Stats",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        {
          "refId": "A",
          "topicName": "grafana_data",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "avg_cell_temp_stat", "max_cell_temp", "min_cell_temp"] } } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Flow Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        {
          "refId": "A",
          "topicName": "grafana_data",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "flow_rate"] } } }
      ]
    }
  ]
}
