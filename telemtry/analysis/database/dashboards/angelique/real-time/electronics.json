{
  "title": "Electronics - Angelique (Real-time)",
  "uid": "angelique_electronics_rt",
  "time": { "from": "now-1m", "to": "now" },
  "refresh": "1s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traction Control (Velocity & Wheel Speeds)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        { "refId": "A", "topicName": "grafana_data", "partition": "all", "autoOffsetReset": "latest", "timestampMode": "message", "messageFormat": "json" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "gps_velocity", "flw_speed", "frw_speed"] } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "gps_velocity" }, "properties": [{ "id": "displayName", "value": "GPS Velocity" }] },
          { "matcher": { "id": "byName", "options": "flw_speed" }, "properties": [{ "id": "displayName", "value": "FL Speed" }] },
          { "matcher": { "id": "byName", "options": "frw_speed" }, "properties": [{ "id": "displayName", "value": "FR Speed" }] }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LV Power Draw (Calculated)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        { "refId": "A", "topicName": "grafana_data", "partition": "all", "autoOffsetReset": "latest", "timestampMode": "message", "messageFormat": "json" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "lv_v", "lv_c"] } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "lv_v" }, "properties": [{ "id": "displayName", "value": "Voltage" }] },
          { "matcher": { "id": "byName", "options": "lv_c" }, "properties": [{ "id": "displayName", "value": "Current" }] }
        ]
      }
    }
  ]
}
