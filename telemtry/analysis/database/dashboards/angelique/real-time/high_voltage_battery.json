{
  "title": "High Voltage Battery - Angelique (Real-time)",
  "uid": "angelique_hv_batt_rt",
  "time": { "from": "now-5m", "to": "now" },
  "refresh": "1s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HV Battery Voltage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        { "refId": "A", "topicName": "grafana_data", "partition": "all", "autoOffsetReset": "latest", "timestampMode": "message", "messageFormat": "json" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "hv_pack_v"] } } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HV Power (Voltage & Current)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        { "refId": "A", "topicName": "grafana_data", "partition": "all", "autoOffsetReset": "latest", "timestampMode": "message", "messageFormat": "json" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "hv_pack_v", "hv_c"] } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "hv_pack_v" }, "properties": [{ "id": "displayName", "value": "Voltage" }] },
          { "matcher": { "id": "byName", "options": "hv_c" }, "properties": [{ "id": "displayName", "value": "Current" }] }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cell Voltage Stats",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "hamedkarbasi93-kafka-datasource", "uid": "real-time-data" },
      "targets": [
        { "refId": "A", "topicName": "grafana_data", "partition": "all", "autoOffsetReset": "latest", "timestampMode": "message", "messageFormat": "json" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["time", "avg_cell_v_stat", "max_cell_v", "min_cell_v"] } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg_cell_v_stat" }, "properties": [{ "id": "displayName", "value": "Avg" }] },
          { "matcher": { "id": "byName", "options": "max_cell_v" }, "properties": [{ "id": "displayName", "value": "Max" }] },
          { "matcher": { "id": "byName", "options": "min_cell_v" }, "properties": [{ "id": "displayName", "value": "Min" }] }
        ]
      }
    }
  ]
}
