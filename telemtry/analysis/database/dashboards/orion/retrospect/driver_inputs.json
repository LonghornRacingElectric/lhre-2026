      "pluginVersion": "11.3.0",
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS ( SELECT p.start_time AS effective_start, p.end_time AS effective_end FROM partitions p WHERE (COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[],1),0) = 0 OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])) ), granularity AS ( SELECT GREATEST($__interval_ms::double precision, 1) AS step_ms ) SELECT to_timestamp(floor(packet.time / granularity.step_ms) * granularity.step_ms / 1000.0) AS time, AVG(controls.accel_pedal_travel) AS \"Throttle Travel [%]\", AVG(controls.brake_pressure_f) AS \"Brake Pressure Front [psi]\", AVG(controls.brake_bias) AS \"Brake Bias [%]\" FROM controls JOIN packet ON packet.packet_id = controls.packet_id JOIN bounds ON true JOIN granularity ON true WHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end GROUP BY 1 ORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Throttle & Brake Inputs",
      "type": "timeseries"
    },
