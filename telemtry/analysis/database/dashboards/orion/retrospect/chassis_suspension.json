      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH session AS (\n  SELECT partition_name, start_time, end_time\n  FROM partitions\n  WHERE partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])\n),\nbase AS (\n  SELECT\n    packet.time,\n    session.partition_name,\n    dynamics.fl_sus_pot_v,\n    dynamics.fr_sus_pot_v,\n    dynamics.bl_sus_pot_v,\n    dynamics.br_sus_pot_v,\n    LAG(dynamics.fl_sus_pot_v) OVER (PARTITION BY session.partition_name ORDER BY packet.time) AS fl_prev,\n    LAG(dynamics.fr_sus_pot_v) OVER (PARTITION BY session.partition_name ORDER BY packet.time) AS fr_prev,\n    LAG(dynamics.bl_sus_pot_v) OVER (PARTITION BY session.partition_name ORDER BY packet.time) AS bl_prev,\n    LAG(dynamics.br_sus_pot_v) OVER (PARTITION BY session.partition_name ORDER BY packet.time) AS br_prev,\n    LAG(packet.time)           OVER (PARTITION BY session.partition_name ORDER BY packet.time) AS prev_time\n  FROM dynamics\n  JOIN packet  ON packet.packet_id = dynamics.packet_id\n  JOIN session ON packet.time BETWEEN session.start_time AND session.end_time\n),\ngranularity AS (\n  SELECT GREATEST($__interval_ms::double precision, 1) AS step_ms\n)\nSELECT\n  to_timestamp(floor(base.time / granularity.step_ms) * granularity.step_ms / 1000.0) AS time,\n  AVG(CASE WHEN prev_time IS NOT NULL AND base.time > prev_time THEN (fl_sus_pot_v - fl_prev) / ((base.time - prev_time)/1000.0) END) AS \"FL Damper Vel [V/s]\",\n  AVG(CASE WHEN prev_time IS NOT NULL AND base.time > prev_time THEN (fr_sus_pot_v - fr_prev) / ((base.time - prev_time)/1000.0) END) AS \"FR Damper Vel [V/s]\",\n  AVG(CASE WHEN prev_time IS NOT NULL AND base.time > prev_time THEN (bl_sus_pot_v - bl_prev) / ((base.time - prev_time)/1000.0) END) AS \"BL Damper Vel [V/s]\",\n  AVG(CASE WHEN prev_time IS NOT NULL AND base.time > prev_time THEN (br_sus_pot_v - br_prev) / ((base.time - prev_time)/1000.0) END) AS \"BR Damper Vel [V/s]\"\nFROM base\nCROSS JOIN granularity\nGROUP BY 1\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Suspension Pot Velocity — Damper Activity [V/s]",
      "type": "timeseries"
    },
