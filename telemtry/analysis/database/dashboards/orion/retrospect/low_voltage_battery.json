          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(lv_boards_current) AS \"vcu/lv_boards_current [A]\", AVG(shutdown_current) AS \"vcu/shutdown_current [A]\", AVG(batt_cooling_current) AS \"vcu/batt_cooling_current [A]\", AVG(motor_cooling_current) AS \"vcu/motor_cooling_current [A]\", AVG(lights_current) AS \"vcu/lights_current [A]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        pack.lv_boards_current, diagnostics_high.shutdown_current, thermal.batt_cooling_current, thermal.motor_cooling_current, controls.lights_current\n    FROM packet LEFT JOIN pack ON pack.packet_id = packet.packet_id LEFT JOIN diagnostics_high ON diagnostics_high.packet_id = packet.packet_id LEFT JOIN thermal ON thermal.packet_id = packet.packet_id LEFT JOIN controls ON controls.packet_id = packet.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
