      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(lv_batt_v) AS \"pdu/lv_batt_v [V]\", AVG(lv_batt_c) AS \"pdu/lv_batt_c [A]\", AVG(lv_batt_t) AS \"pdu/lv_batt_t [C]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        pack.lv_batt_v, pack.lv_batt_c, pack.lv_batt_t\n    FROM pack JOIN packet ON packet.packet_id = pack.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "LV Battery Core Signals",
      "type": "timeseries"
    },
