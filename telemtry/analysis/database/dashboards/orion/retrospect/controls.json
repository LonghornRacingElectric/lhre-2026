          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(apps1_travel) AS \"vcu/apps1_travel [%]\", AVG(apps2_travel) AS \"vcu/apps2_travel [%]\", AVG(bpps1_travel) AS \"vcu/bpps1_travel [%]\", AVG(bpps2_travel) AS \"vcu/bpps2_travel [%]\", AVG(brake_light_pct) AS \"vcu/brake_light_pct [%]\", AVG(brake_bias) AS \"vcu/brake_bias [%]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        controls.apps1_travel, controls.apps2_travel, controls.bpps1_travel, controls.bpps2_travel, controls.brake_light_pct, controls.brake_bias\n    FROM controls JOIN packet ON packet.packet_id = controls.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
