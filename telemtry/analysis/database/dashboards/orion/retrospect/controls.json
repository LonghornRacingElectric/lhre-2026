        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(apps1_v) AS \"vcu/apps1_v [V]\", AVG(apps2_v) AS \"vcu/apps2_v [V]\", AVG(bpps1_v) AS \"vcu/bpps1_v [V]\", AVG(bpps2_v) AS \"vcu/bpps2_v [V]\", AVG(bse1_v) AS \"vcu/bse1_v [V]\", AVG(bse2_v) AS \"vcu/bse2_v [V]\", AVG(bse3_v) AS \"vcu/bse3_v [V]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        controls.apps1_v, controls.apps2_v, controls.bpps1_v, controls.bpps2_v, controls.bse1_v, controls.bse2_v, controls.bse3_v\n    FROM controls JOIN packet ON packet.packet_id = controls.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Pedal and Brake Sensor Voltages [V]",
      "type": "timeseries"
    },
