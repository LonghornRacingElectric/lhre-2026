      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n    AVG(gps_imu[1]::double precision) OVER (\r\n        ORDER BY packet_id \r\n        ROWS BETWEEN 10 PRECEDING AND CURRENT ROW\r\n    ) AS lat_accel,\r\n    AVG(-gps_imu[2]::double precision) OVER (\r\n        ORDER BY packet_id \r\n        ROWS BETWEEN 10 PRECEDING AND CURRENT ROW\r\n    ) AS long_accel\r\nFROM dynamics\r\nWHERE gps_imu IS NOT NULL \r\n  AND array_length(gps_imu, 1) >= 2\r\nORDER BY packet_id DESC\r\nLIMIT 50000",
          "refId": "A",
          "sql": {
