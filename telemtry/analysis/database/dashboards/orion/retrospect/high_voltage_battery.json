        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(flw_speed) AS \"usm/flw_speed [rad/s]\", AVG(frw_speed) AS \"usm/frw_speed [rad/s]\", AVG(blw_speed) AS \"usm/blw_speed [rad/s]\", AVG(brw_speed) AS \"usm/brw_speed [rad/s]\", AVG(wheel_speed) AS \"usm/wheel_speed [rad/s]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        dynamics.flw_speed, dynamics.frw_speed, dynamics.blw_speed, dynamics.brw_speed, dynamics.wheel_speed\n    FROM dynamics JOIN packet ON packet.packet_id = dynamics.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Wheel Speeds [rad/s]",
      "type": "timeseries"
    },
