      "pluginVersion": "11.3.0",
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT MIN(p.start_time) AS effective_start, MAX(p.end_time) AS effective_end\n  FROM partitions p\n  WHERE p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])\n),\ngranularity AS (\n  SELECT GREATEST($__interval_ms::double precision, 1) AS step_ms\n)\nSELECT\n  to_timestamp(floor(packet.time / granularity.step_ms) * granularity.step_ms / 1000.0) AS time,\n  AVG((dynamics.gps_imu)[2])       AS \"Lateral Accel [m/s²]\",\n  AVG((dynamics.gps_imu)[1])       AS \"Longitudinal Accel [m/s²]\",\n  AVG(dynamics.gps_speed)          AS \"GPS Speed [m/s]\",\n  AVG(dynamics.accel_pedal_travel) AS \"Throttle [%]\"\nFROM dynamics\nJOIN packet ON packet.packet_id = dynamics.packet_id\nCROSS JOIN bounds\nCROSS JOIN granularity\nWHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\nGROUP BY 1\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Accel, Speed & Throttle — Time Domain",
      "type": "timeseries"
    }
