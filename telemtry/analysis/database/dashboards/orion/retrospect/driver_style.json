          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT MIN(p.start_time) AS effective_start, MAX(p.end_time) AS effective_end\n  FROM partitions p\n  WHERE p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])\n)\nSELECT\n  ctl.brake_pressure_f AS \"Brake Pressure Front [psi]\",\n  (dyn.gps_imu)[1]     AS \"Long. Decel [m/s²]\"\nFROM dynamics dyn\nJOIN controls ctl ON ctl.packet_id = dyn.packet_id\nJOIN packet       ON packet.packet_id = dyn.packet_id\nCROSS JOIN bounds\nWHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\n  AND ctl.brake_pressure_f > 5\nORDER BY packet.time;",
