      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT MIN(p.start_time) AS effective_start, MAX(p.end_time) AS effective_end\n  FROM partitions p\n  WHERE p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])\n)\nSELECT\n  (dynamics.gps_imu)[2] AS \"Lateral Accel [m/s²]\",\n  (dynamics.gps_imu)[1] AS \"Longitudinal Accel [m/s²]\",\n  dynamics.gps_speed    AS \"GPS Speed [m/s]\"\nFROM dynamics\nJOIN packet ON packet.packet_id = dynamics.packet_id\nCROSS JOIN bounds\nWHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\n  AND (dynamics.gps_imu)[1] IS NOT NULL\nORDER BY packet.time;",
          "refId": "A"
        }
      ],
      "title": "GG Diagram (colored by GPS Speed)",
      "type": "xychart"
    },
