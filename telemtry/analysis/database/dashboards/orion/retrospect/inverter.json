        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(module_a_temp) AS \"inv/module_a_temp [C]\",\n  AVG(module_b_temp) AS \"inv/module_b_temp [C]\",\n  AVG(module_c_temp) AS \"inv/module_c_temp [C]\",\n  AVG(gate_driver_temp) AS \"inv/gate_driver_temp [C]\",\n  AVG(coolant_temp) AS \"inv/coolant_temp [C]\",\n  AVG(inverter_hotspot_temp) AS \"inv/inverter_hotspot_temp [C]\",\n  AVG(motor_temp) AS \"inv/motor_temp [C]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        thermal.module_a_temp, thermal.module_b_temp, thermal.module_c_temp, thermal.gate_driver_temp, thermal.coolant_temp, thermal.inverter_hotspot_temp, thermal.motor_temp\n    FROM thermal\nJOIN packet \n  ON packet.packet_id = thermal.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [

                ],
                "type": "function"
              }
            ],
