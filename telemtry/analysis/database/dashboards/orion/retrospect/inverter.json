      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT \n    p.start_time AS effective_start, \n    p.end_time AS effective_end\n  FROM partitions p\n  WHERE (\n    COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[],1),0) = 0 \n    OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[])\n  )\n),\ngranularity AS (\n  SELECT \n    $__interval_ms::double precision AS step_ms\n)\n\nSELECT \n  to_timestamp(\n    floor(packet.time::double precision / granularity.step_ms) \n    * granularity.step_ms / 1000.0\n  ) AS time,\n\n  AVG(thermal.module_a_temp) AS \"inv/module_a_temp [C]\",\n  AVG(thermal.module_b_temp) AS \"inv/module_b_temp [C]\",\n  AVG(thermal.module_c_temp) AS \"inv/module_c_temp [C]\",\n  AVG(thermal.gate_driver_temp) AS \"inv/gate_driver_temp [C]\",\n  AVG(thermal.coolant_temp) AS \"inv/coolant_temp [C]\",\n  AVG(thermal.inverter_hotspot_temp) AS \"inv/inverter_hotspot_temp [C]\",\n  AVG(thermal.motor_temp) AS \"inv/motor_temp [C]\"\n\nFROM thermal\nJOIN packet \n  ON packet.packet_id = thermal.packet_id\nJOIN bounds \n  ON TRUE\nJOIN granularity \n  ON TRUE\n\nWHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\n\nGROUP BY 1\nORDER BY time;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Inverter Temperatures [C]",
      "type": "timeseries"
