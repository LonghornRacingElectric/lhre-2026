      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "AS step_ms ), cell_t AS (SELECT to_timestamp(packet.time / 1000.0) AS ts, UNNEST(pack.cells_temps) AS value FROM pack JOIN packet ON packet.packet_id = pack.packet_id WHERE $__timeFilter(to_timestamp(packet.time / 1000.0))), thermal_t AS (SELECT to_timestamp(packet.time / 1000.0) AS ts, AVG(thermal.cell_top_temp) AS cell_top_temp, AVG(thermal.cell_bottom_temp) AS cell_bottom_temp, AVG(thermal.bus_bar_temp1) AS bus_bar_temp1, AVG(thermal.bus_bar_temp2) AS bus_bar_temp2, AVG(thermal.bus_bar_temp3) AS bus_bar_temp3 FROM thermal JOIN packet ON packet.packet_id = thermal.packet_id WHERE $__timeFilter(to_timestamp(packet.time / 1000.0)) GROUP BY 1), diag_t AS (SELECT to_timestamp(packet.time / 1000.0) AS ts, AVG(diagnostics_low.precharge_r_temp) AS precharge_r_temp FROM diagnostics_low JOIN packet ON packet.packet_id = diagnostics_low.packet_id WHERE $__timeFilter(to_timestamp(packet.time / 1000.0)) GROUP BY 1) SELECT cell_t.time, AVG(cell_t.value) AS \"hvc/cells_temp_avg [C]\", MIN(cell_t.value) AS \"hvc/cells_temp_min [C]\", MAX(cell_t.value) AS \"hvc/cells_temp_max [C]\", MAX(thermal_t.cell_top_temp) AS \"hvc/cell_top_temp [C]\", MAX(thermal_t.cell_bottom_temp) AS \"hvc/cell_bottom_temp [C]\", MAX(thermal_t.bus_bar_temp1) AS \"hvc/bus_bar_temp1 [C]\", MAX(thermal_t.bus_bar_temp2) AS \"hvc/bus_bar_temp2 [C]\", MAX(thermal_t.bus_bar_temp3) AS \"hvc/bus_bar_temp3 [C]\", MAX(diag_t.precharge_r_temp) AS \"hvc/precharge_r_temp [C]\" FROM cell_t LEFT JOIN thermal_t ON thermal_t.time = cell_t.time LEFT JOIN diag_t ON diag_t.time = cell_t.time GROUP BY cell_t.time ORDER BY cell_t.time;",
          "refId": "A"
        }
      ],
      "title": "Cell and Bus Thermal Signals [C]",
      "type": "timeseries"
    }
