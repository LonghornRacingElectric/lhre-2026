          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(module_a_temp) AS \"thermal/module_a_temp [C]\", AVG(module_b_temp) AS \"thermal/module_b_temp [C]\", AVG(module_c_temp) AS \"thermal/module_c_temp [C]\", AVG(gate_driver_temp) AS \"thermal/gate_driver_temp [C]\", AVG(inverter_hotspot_temp) AS \"thermal/inverter_hotspot_temp [C]\", AVG(discharge_r_temp) AS \"thermal/discharge_r_temp [C]\", AVG(precharge_r_temp) AS \"thermal/precharge_r_temp [C]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        thermal.module_a_temp, thermal.module_b_temp, thermal.module_c_temp, thermal.gate_driver_temp, thermal.inverter_hotspot_temp, thermal.discharge_r_temp, diagnostics_low.precharge_r_temp\n    FROM thermal JOIN packet ON packet.packet_id = thermal.packet_id LEFT JOIN diagnostics_low ON diagnostics_low.packet_id = thermal.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
