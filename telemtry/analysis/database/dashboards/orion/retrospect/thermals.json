      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(ambient_temp) AS \"thermal/ambient_temp [C]\", AVG(coolant_temp) AS \"thermal/coolant_temp [C]\", AVG(motor_temp) AS \"thermal/motor_temp [C]\", AVG(inverter_temp) AS \"thermal/inverter_temp [C]\", AVG(batt_loop_batt_temp) AS \"thermal/batt_loop_batt_temp [C]\", AVG(motor_loop_motor_temp) AS \"thermal/motor_loop_motor_temp [C]\", AVG(motor_loop_inverter_temp) AS \"thermal/motor_loop_inverter_temp [C]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        thermal.ambient_temp, thermal.coolant_temp, thermal.motor_temp, thermal.inverter_temp, thermal.batt_loop_batt_temp, thermal.motor_loop_motor_temp, thermal.motor_loop_inverter_temp\n    FROM thermal JOIN packet ON packet.packet_id = thermal.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Core Thermal Temperatures [C]",
      "type": "timeseries"
    },
