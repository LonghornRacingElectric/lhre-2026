          "rawSql": "SELECT\n    $__timeGroup(ts, $__interval),\n    AVG(batt_loop_rad_fan_speed) AS \"thermal/batt_loop_rad_fan_speed\", AVG(motor_loop_rad_fan_speed) AS \"thermal/motor_loop_rad_fan_speed\", AVG(batt_loop_rad_temp) AS \"thermal/batt_loop_rad_temp [C]\", AVG(motor_loop_rad_temp) AS \"thermal/motor_loop_rad_temp [C]\", AVG(batt_cooling_current) AS \"thermal/batt_cooling_current [A]\", AVG(motor_cooling_current) AS \"thermal/motor_cooling_current [A]\"\nFROM (\n    SELECT\n        to_timestamp(packet.time / 1000.0) AS ts,\n        thermal.batt_loop_rad_fan_speed, thermal.motor_loop_rad_fan_speed, thermal.batt_loop_rad_temp, thermal.motor_loop_rad_temp, thermal.batt_cooling_current, thermal.motor_cooling_current\n    FROM thermal JOIN packet ON packet.packet_id = thermal.packet_id\n) t\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
