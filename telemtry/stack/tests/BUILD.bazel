# telemtry/stack/tests/BUILD.bazel
# Integration tests for the telemetry stack
# Tests communication between Docker containers and non-Docker scripts

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@telemtry_reqs//:requirements.bzl", "requirement")

package(default_visibility = ["//telemtry:__subpackages__"])

# Common test utilities library
py_library(
    name = "test_utils",
    srcs = ["test_utils.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//telemtry/analysis:analysis_lib",
        "//telemtry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
        requirement("numpy"),
        requirement("paho-mqtt"),
        requirement("pandas"),
        requirement("protobuf"),
        requirement("psycopg2-binary"),
        requirement("python-dotenv"),
        requirement("requests"),
        requirement("SQLAlchemy"),
    ],
)

# Stack test client - tests container communication
py_binary(
    name = "stack_test_client",
    srcs = ["test_stack_client.py"],
    main = "test_stack_client.py",
    deps = [
        ":test_utils",
        requirement("Flask"),
        requirement("jupyter"),
        requirement("numpy"),
        requirement("matplotlib"),
        requirement("paho-mqtt"),
        requirement("pandas"),
        requirement("protobuf"),
        requirement("SQLAlchemy"),
        requirement("psycopg2-binary"),
        requirement("requests"),
        requirement("seaborn"),
        requirement("tqdm"),
        requirement("flask_login"),
        requirement("gunicorn"),
        requirement("flask_bcrypt"),
        requirement("python-dotenv"),
        requirement("kafka-python"),
    ],
)

# MQTT connectivity test
py_test(
    name = "mqtt_connectivity_test",
    srcs = ["test_mqtt_connectivity.py"],
    main = "test_mqtt_connectivity.py",
    data = ["//telemtry:env_files"],
    deps = [
        ":test_utils",
        requirement("paho-mqtt"),
        requirement("python-dotenv"),
    ],
    tags = ["integration", "docker", "local"],
)

# Kafka connectivity test
py_test(
    name = "kafka_connectivity_test",
    srcs = ["test_kafka_connectivity.py"],
    main = "test_kafka_connectivity.py",
    data = ["//telemtry:env_files"],
    deps = [
        ":test_utils",
        requirement("kafka-python"),
        requirement("python-dotenv"),
    ],
    tags = ["integration", "docker", "local"],
)

# Database connectivity test
py_test(
    name = "db_connectivity_test",
    srcs = ["test_db_connectivity.py"],
    main = "test_db_connectivity.py",
    data = ["//telemtry:env_files"],
    deps = [
        ":test_utils",
        "//telemtry/analysis:analysis_lib",
        requirement("psycopg2-binary"),
        requirement("SQLAlchemy"),
        requirement("python-dotenv"),
    ],
    tags = ["integration", "docker", "local"],
)

# End-to-end data flow test (MQTT -> Ingest -> Kafka -> DB)
py_test(
    name = "data_flow_test",
    srcs = ["test_data_flow.py"],
    main = "test_data_flow.py",
    data = ["//telemtry:env_files"],
    deps = [
        ":test_utils",
        "//telemtry/analysis:analysis_lib",
        "//telemtry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
        requirement("paho-mqtt"),
        requirement("protobuf"),
        requirement("psycopg2-binary"),
        requirement("python-dotenv"),
        requirement("SQLAlchemy"),
    ],
    tags = ["integration", "docker", "e2e", "local"],
)

# Protobuf serialization test (tests paho_testing.py patterns)
py_test(
    name = "protobuf_test",
    srcs = ["test_protobuf.py"],
    main = "test_protobuf.py",
    data = ["//telemtry:env_files"],
    deps = [
        ":test_utils",
        "//telemtry/analysis:analysis_lib",
        "//telemtry/stack/ingest:ingest_lib",
        requirement("numpy"),
        requirement("protobuf"),
        requirement("python-dotenv"),
    ],
    tags = ["unit"],
)

# Export shell scripts and docker-compose files
exports_files([
    "run_integration_test.sh",
    "test_stack_client.py",
])

# Integration test target - uses shell script to manage Docker lifecycle
sh_test(
    name = "stack_integration_test",
    srcs = ["run_integration_test.sh"],
    data = [
        ":stack_test_client",
        "//telemtry/stack/ingest:docker-compose.yml",
        "//telemtry/stack/kafka:docker-compose.yml",
        "//telemtry/stack/processors/gps_classifier:docker-compose.yml",
        "//telemtry/stack/processors/kafka_base:docker-compose.yml",
        "//telemtry/stack/processors/lap_timer:docker-compose.yml",
        "//telemtry:config_files",
    ],
    tags = ["integration", "docker", "manual", "local"],
)

# Test suite for all integration tests (requires Docker to be running)
test_suite(
    name = "integration_tests",
    tags = ["integration", "local"],
    tests = [
        ":data_flow_test",
        ":db_connectivity_test",
        ":kafka_connectivity_test",
        ":mqtt_connectivity_test",
    ],
)

# Test suite for unit tests (no Docker required)
test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = [
        ":protobuf_test",
    ],
)

# All telemetry stack tests
test_suite(
    name = "all_tests",
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
)
