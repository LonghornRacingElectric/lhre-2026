# Copy to .env (or fold into telemtry/.env) and adjust per deployment.

# --- Pi access (rsync over SSH over Tailscale) ---
BEVO_SSH_TARGET=lhre@100.64.195.68
BEVO_SSH_KEY=/keys/id_logsync
BEVO_LOG_DIR=Documents/lhre/lhre-2026/BEVO/loggerd/logs

# --- Motion detection (Orion telemetry DB) ---
# With host networking the db container is reachable on localhost:5432.
LOGSYNC_PG_HOST=127.0.0.1
LOGSYNC_PG_PORT=5432
LOGSYNC_PG_DB=orion
LOGSYNC_PG_USER=electric
# Defaults to $ELECTRIC_PWD if unset:
# LOGSYNC_PG_PASSWORD=

# Car counts as "moving" above this speed (m/s) when telemetry is fresh.
LOGSYNC_SPEED_THRESHOLD_MPS=0.5
LOGSYNC_MOTION_STALENESS_MS=10000
LOGSYNC_MOTION_RESUME_STABLE_S=10

# --- Bandwidth (0 = unlimited; policy is pause-on-motion) ---
LOGSYNC_DEFAULT_BWLIMIT_KBPS=0
